if not game:IsLoaded() then
   game.Loaded:Wait()
end

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

local GC = getconnections or get_signal_cons
if GC then
    for _, v in pairs(GC(LocalPlayer.Idled)) do
        if v["Disable"] then
            v["Disable"](v)
        end
    end
end

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Horrific Housing Hub",
   LoadingTitle = "Horrific Housing Hub",
   LoadingSubtitle = "By semihu55",
   ConfigurationSaving = {
      Enabled = false,
      FolderName = "HorrificHousingSemi",
      FileName = "Config"
   },
   KeySystem = false,
   KeySettings = {
      Title = "Hub Key",
      Subtitle = "Key System",
      Note = "No key required",
      FileName = "HubKey",
      SaveKey = true,
      GrabKeyFromSite = false,
      Key = {"1234"}
   }
})

local SurvivalTab = Window:CreateTab("Survival", 4483362458)
local VisualsTab  = Window:CreateTab("Visuals",  4483362458)
local ItemsTab    = Window:CreateTab("Items",    4483362458)
local PlayerTab   = Window:CreateTab("Player",   4483362458)
local TrollTab    = Window:CreateTab("Troll",    4483362458)

local safespotActive = false
local safespotOriginalPos = nil

SurvivalTab:CreateToggle({
   Name = "Safespot",
   CurrentValue = false,
   Flag = "SafespotFlag",
   Callback = function(Value)
      safespotActive = Value
      local character = LocalPlayer.Character
      if safespotActive then
         if character and character:FindFirstChild("HumanoidRootPart") then
            safespotOriginalPos = character.HumanoidRootPart.CFrame
         end
         task.spawn(function()
            while safespotActive do
               local char = LocalPlayer.Character
               if char and char:FindFirstChild("HumanoidRootPart") then
                  char.HumanoidRootPart.CFrame = CFrame.new(0, 500, 0)
                  char.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
               end
               task.wait()
            end
         end)
      else
         task.spawn(function()
            local char = LocalPlayer.Character
            if safespotOriginalPos and char and char:FindFirstChild("HumanoidRootPart") then
               char.HumanoidRootPart.CFrame = safespotOriginalPos
            end
         end)
      end
   end,
})

local antiVoidActive = false
local lastSafePos = nil

SurvivalTab:CreateToggle({
   Name = "Anti Void",
   CurrentValue = false,
   Flag = "AntiVoidFlag",
   Callback = function(Value)
      antiVoidActive = Value
      task.spawn(function()
         while antiVoidActive do
            local character = LocalPlayer.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
               local hrp = character.HumanoidRootPart
               if hrp.Position.Y > 0 then
                  lastSafePos = hrp.CFrame
               elseif hrp.Position.Y < -20 then
                  if lastSafePos then
                     hrp.CFrame = lastSafePos
                     hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                  else
                     hrp.CFrame = CFrame.new(0, 50, 0)
                  end
               end
            end
            task.wait()
         end
      end)
   end,
})

local antiDeathBlocksActive = false

SurvivalTab:CreateToggle({
   Name = "Anti Death Blocks",
   CurrentValue = false,
   Flag = "AntiDeathFlag",
   Callback = function(Value)
      antiDeathBlocksActive = Value
      task.spawn(function()
         while antiDeathBlocksActive do
            pcall(function()
               local character = LocalPlayer.Character
               if character then
                  for _, v in pairs(character:GetDescendants()) do
                     if v:IsA("TouchTransmitter") then
                        v:Destroy()
                     end
                  end
               end
            end)
            task.wait()
         end
      end)
   end,
})

local autoGiftActive = false

SurvivalTab:CreateToggle({
   Name = "Gift",
   CurrentValue = false,
   Flag = "GiftFlag",
   Callback = function(Value)
      autoGiftActive = Value
      task.spawn(function()
         while autoGiftActive do
            pcall(function()
               for _, v in pairs(Workspace:GetDescendants()) do
                  if v:IsA("ProximityPrompt") and v.Name == "Gift" then
                     if fireproximityprompt then
                        fireproximityprompt(v)
                     else
                        v:InputHoldBegin()
                        task.wait(0.1)
                        v:InputHoldEnd()
                     end
                  end
               end
            end)
            task.wait(0.5)
         end
      end)
   end,
})

local espActive = false

VisualsTab:CreateToggle({
   Name = "ESP",
   CurrentValue = false,
   Flag = "ESPFlag",
   Callback = function(Value)
      espActive = Value
      task.spawn(function()
         while espActive do
            for _, player in pairs(Players:GetPlayers()) do
               if player ~= LocalPlayer and player.Character then
                  if not player.Character:FindFirstChild("Highlight") then
                     local hl = Instance.new("Highlight")
                     hl.Parent = player.Character
                     if player.Team then
                        hl.FillColor = player.Team.TeamColor.Color
                     else
                        hl.FillColor = Color3.fromRGB(255, 255, 255)
                     end
                     hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                  else
                     local hl = player.Character:FindFirstChild("Highlight")
                     if hl and player.Team then
                        hl.FillColor = player.Team.TeamColor.Color
                     end
                  end
               end
            end
            task.wait(0.5)
         end
         for _, player in pairs(Players:GetPlayers()) do
            if player.Character and player.Character:FindFirstChild("Highlight") then
               player.Character.Highlight:Destroy()
            end
         end
      end)
   end,
})

local fullbrightActive = false
local origBrightness = Lighting.Brightness
local origClockTime = Lighting.ClockTime
local origShadows = Lighting.GlobalShadows

VisualsTab:CreateToggle({
   Name = "FullBright",
   CurrentValue = false,
   Flag = "BrightFlag",
   Callback = function(Value)
      fullbrightActive = Value
      if fullbrightActive then
         origBrightness = Lighting.Brightness
         origClockTime = Lighting.ClockTime
         origShadows = Lighting.GlobalShadows
         task.spawn(function()
            while fullbrightActive do
               Lighting.Brightness = 2
               Lighting.ClockTime = 14
               Lighting.GlobalShadows = false
               task.wait(0.5)
            end
         end)
      else
         Lighting.Brightness = origBrightness
         Lighting.ClockTime = origClockTime
         Lighting.GlobalShadows = origShadows
      end
   end,
})

local xrayActive = false
local originalTransparencies = {}

VisualsTab:CreateToggle({
   Name = "Xray",
   CurrentValue = false,
   Flag = "XrayFlag",
   Callback = function(Value)
      xrayActive = Value
      task.spawn(function()
         if xrayActive then
            pcall(function()
               for _, v in pairs(Workspace:GetDescendants()) do
                  if v:IsA("BasePart") and not v.Parent:FindFirstChild("Humanoid") then
                     originalTransparencies[v] = v.Transparency
                     v.Transparency = 0.5
                  end
               end
            end)
         else
            pcall(function()
               for v, trans in pairs(originalTransparencies) do
                  if v and v.Parent then
                     v.Transparency = trans
                  end
               end
               originalTransparencies = {}
            end)
         end
      end)
   end,
})

local autoGrabActive = false

ItemsTab:CreateToggle({
   Name = "Auto Grab Items",
   CurrentValue = false,
   Flag = "GrabFlag",
   Callback = function(Value)
      autoGrabActive = Value
      task.spawn(function()
         while autoGrabActive do
            pcall(function()
               local character = LocalPlayer.Character
               if character and character:FindFirstChild("HumanoidRootPart") then
                  for _, v in pairs(Workspace:GetDescendants()) do
                     if v:IsA("Tool") and v:FindFirstChild("Handle") then
                        local characterModel = v:FindFirstAncestorWhichIsA("Model")
                        local belongsToPlayer = false
                        if characterModel then
                           for _, player in pairs(Players:GetPlayers()) do
                              if player.Character == characterModel then
                                 belongsToPlayer = true
                                 break
                              end
                           end
                        end
                        if not belongsToPlayer then
                           v.Handle.CFrame = character.HumanoidRootPart.CFrame
                        end
                     end
                  end
               end
            end)
            task.wait()
         end
      end)
   end,
})

ItemsTab:CreateButton({
   Name = "Use All Items",
   Callback = function()
      pcall(function()
         local player = LocalPlayer
         local character = player.Character
         local backpack = player.Backpack
         if character and backpack then
            for _, tool in pairs(backpack:GetChildren()) do
               if tool:IsA("Tool") then
                  tool.Parent = character
                  tool:Activate()
               end
            end
            for _, tool in pairs(character:GetChildren()) do
               if tool:IsA("Tool") then
                  tool:Activate()
               end
            end
         end
      end)
   end,
})

local killAuraDistance = 25

ItemsTab:CreateSlider({
   Name = "KillAura Distance",
   Range = {5, 100},
   Increment = 1,
   CurrentValue = 25,
   Flag = "KillAuraDistFlag",
   Callback = function(Value)
      killAuraDistance = Value
   end,
})

local killAuraActive = false

ItemsTab:CreateToggle({
   Name = "KillAura (For Close Combat)",
   CurrentValue = false,
   Flag = "KillAuraFlag",
   Callback = function(Value)
      killAuraActive = Value
      task.spawn(function()
         while killAuraActive do
            pcall(function()
               local character = LocalPlayer.Character
               if character and character:FindFirstChild("HumanoidRootPart") then
                  local hrp = character.HumanoidRootPart
                  for _, player in pairs(Players:GetPlayers()) do
                     if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
                        if player.Character.Humanoid.Health > 0 then
                           local dist = (hrp.Position - player.Character.HumanoidRootPart.Position).Magnitude
                           if dist <= killAuraDistance then
                              local tool = character:FindFirstChildOfClass("Tool")
                              if tool and tool:FindFirstChild("Handle") then
                                 for _, part in pairs(player.Character:GetDescendants()) do
                                    if part:IsA("BasePart") then
                                       firetouchinterest(tool.Handle, part, 0)
                                       firetouchinterest(tool.Handle, part, 1)
                                    end
                                 end
                              else
                                 for _, part in pairs(player.Character:GetDescendants()) do
                                    if part:IsA("BasePart") then
                                       firetouchinterest(hrp, part, 0)
                                       firetouchinterest(hrp, part, 1)
                                    end
                                 end
                              end
                           end
                        end
                     end
                  end
               end
            end)
            task.wait(0.1)
         end
      end)
   end,
})

local informInvActive = false

ItemsTab:CreateToggle({
   Name = "Inform About Player Inventories",
   CurrentValue = false,
   Flag = "InvFlag",
   Callback = function(Value)
      informInvActive = Value
      task.spawn(function()
         local connections = {}
         if informInvActive then
            for _, player in pairs(Players:GetPlayers()) do
               if player ~= LocalPlayer then
                  local function setupContainer(container)
                     if container then
                        table.insert(connections, container.ChildAdded:Connect(function(item)
                           if informInvActive and item:IsA("Tool") then
                              pcall(function()
                                 local tools = {}
                                 if player.Backpack then
                                    for _, t in pairs(player.Backpack:GetChildren()) do
                                       if t:IsA("Tool") then
                                          table.insert(tools, t.Name)
                                       end
                                    end
                                 end
                                 if player.Character then
                                    for _, t in pairs(player.Character:GetChildren()) do
                                       if t:IsA("Tool") then
                                          table.insert(tools, t.Name)
                                       end
                                    end
                                 end
                                 Rayfield:Notify({
                                    Title = player.Name .. " got " .. item.Name,
                                    Content = table.concat(tools, ", "),
                                    Duration = 4
                                 })
                              end)
                           end
                        end))
                     end
                  end
                  if player.Backpack then setupContainer(player.Backpack) end
                  table.insert(connections, player.CharacterAdded:Connect(function(char)
                     setupContainer(char)
                  end))
                  if player.Character then setupContainer(player.Character) end
               end
            end
         else
            for _, conn in pairs(connections) do
               conn:Disconnect()
            end
         end
      end)
   end,
})

local targetName = ""

PlayerTab:CreateInput({
   Name = "Target Username or DisplayName",
   PlaceholderText = "Enter name here",
   RemoveTextAfterFocusLost = false,
   Flag = "TargetInput",
   Callback = function(Text)
      targetName = Text
   end,
})

local function getTargetCharacter()
   for _, player in pairs(Players:GetPlayers()) do
      if player ~= LocalPlayer then
         if player.Name:lower():sub(1, #targetName) == targetName:lower() or player.DisplayName:lower():sub(1, #targetName) == targetName:lower() then
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
               return player.Character
            end
         end
      end
   end
   return nil
end

PlayerTab:CreateButton({
   Name = "Fling Target Player",
   Callback = function()
      pcall(function()
         local character = LocalPlayer.Character
         if not character or not character:FindFirstChild("HumanoidRootPart") then return end
         
         local targetChar = getTargetCharacter()
         if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
            local originalPos = character.HumanoidRootPart.CFrame
            character.HumanoidRootPart.CFrame = targetChar.HumanoidRootPart.CFrame
            task.wait(0.1)
            character.HumanoidRootPart.AssemblyAngularVelocity = Vector3.new(99999, 99999, 99999)
            task.wait(0.3)
            character.HumanoidRootPart.CFrame = originalPos
         end
      end)
   end,
})

PlayerTab:CreateButton({
   Name = "Teleport to Player",
   Callback = function()
      pcall(function()
         local character = LocalPlayer.Character
         if not character or not character:FindFirstChild("HumanoidRootPart") then return end
         
         local targetChar = getTargetCharacter()
         if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
            character.HumanoidRootPart.CFrame = targetChar.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
         end
      end)
   end,
})

local viewPlayerActive = false

PlayerTab:CreateToggle({
   Name = "View Player",
   CurrentValue = false,
   Flag = "ViewPlayerFlag",
   Callback = function(Value)
      viewPlayerActive = Value
      task.spawn(function()
         while viewPlayerActive do
            pcall(function()
               local targetChar = getTargetCharacter()
               if targetChar and targetChar:FindFirstChild("Humanoid") then
                  Workspace.CurrentCamera.CameraSubject = targetChar.Humanoid
               end
            end)
            task.wait(0.5)
         end
         pcall(function()
            local character = LocalPlayer.Character
            if character and character:FindFirstChild("Humanoid") then
               Workspace.CurrentCamera.CameraSubject = character.Humanoid
            end
         end)
      end)
   end,
})

