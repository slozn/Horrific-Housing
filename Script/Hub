local mockPlayersActive = false

TrollTab:CreateToggle({
   Name = "Mock Players",
   CurrentValue = false,
   Flag = "MockFlag",
   Callback = function(Value)
      mockPlayersActive = Value
      task.spawn(function()
         local phrases = {
            "you play like a literal NPC",
            "bro is actually allergic to winning",
            "even a blindfolded noob plays better than you",
            "uninstall the game, you are embarrassing yourself",
            "go back to the tutorial level",
            "touch some grass and come back",
            "are you playing with your feet",
            "absolute zero IQ gameplay right there",
            "bro got zero survival instincts",
            "did you buy your account from a thrift store",
            "even lag has better reflexes than you",
            "you are a professional failure",
            "im convinced your monitor is turned off",
            "what is that positioning, pure comedy",
            "bro is speedrunning getting eliminated",
            "zero mechanical skill detected",
            "you make a brick wall look smart",
            "absolute clown moment",
            "your gaming chair needs an upgrade",
            "skills are currently loading, please wait"
         }
         while mockPlayersActive do
            pcall(function()
               local playersList = Players:GetPlayers()
               if #playersList > 1 then
                  local target = playersList[math.random(1, #playersList)]
                  if target ~= LocalPlayer then
                     local msg = "@" + target.Name + " " + phrases[math.random(1, #phrases)]
                     if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                        local channel = TextChatService.TextChannels.RBXGeneral
                        if channel then
                           channel:SendAsync(msg)
                        end
                     else
                        ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents"):WaitForChild("SayMessageRequest"):FireServer(msg, "All")
                     end
                  end
               end
            end)
            task.wait(7)
         end
      end)
   end,
})
